{
  "displayName": "DoTunnel Client",
  "name": "dotunnel",
  "version": "0.1.1",
  "description": " A CLI client for DoTunnel , a service to expose your local server to the internet easily and securely.",
  "bin": {
    "dotunnel": "dist/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "DOTUNNEL_BASE_URL=localhost:8787 vite build --watch",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "url": "https://github.com/jounaidayoub/dotunnel-client.git",
    "type": "git"
  },
  "type": "module",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^12.9.4",
    "ora": "^8.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "rollup-plugin-node-externals": "^9.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.12",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
